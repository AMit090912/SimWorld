# Copy to .env (never commit .env).
# The backend reads these process environment variables; it does not load .env itself.
# Export them in your shell, Docker Compose, or your hosting provider.

SIMWORLD_ENV=development
SIMWORLD_DB_PATH=./data/simworld.db
SIMWORLD_STATIC_DIR=./frontend/dist
SIMWORLD_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# External agents. Loopback is permitted in development; production defaults to false.
SIMWORLD_AGENT_ALLOW_LOOPBACK=true
SIMWORLD_MAX_AGENT_TIMEOUT_MS=10000

# Any OpenAI-compatible model endpoint. No key is needed for local Ollama.
SIMWORLD_LLM_BASE_URL=http://127.0.0.1:11434/v1
SIMWORLD_LLM_MODEL=qwen2.5:1.5b-instruct
SIMWORLD_LLM_PROVIDER=openai_compatible
SIMWORLD_LLM_TIMEOUT_S=20

# Name of the environment variable that holds the model API key.
# Leave the key itself out of the repository.
SIMWORLD_LLM_API_KEY_ENV=OPENAI_API_KEY

# Used by the MCP bridge.
SIMWORLD_API_URL=http://127.0.0.1:8000
MCP_RUN_TIMEOUT_S=900